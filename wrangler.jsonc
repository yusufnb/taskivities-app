{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "taskivities",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	// Needed by the `agents` SDK (MCP server).
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		// The React app. Anything that isn't a file falls back to index.html (client-side routes).
		"not_found_handling": "single-page-application",
		// These paths always go to the Worker, never to static files.
		// /mcp and the OAuth endpoints are for AI assistants (MCP clients); see worker/index.ts.
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/mcp",
			"/mcp/*",
			"/authorize",
			"/token",
			"/register",
			"/.well-known/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "taskivities",
			"database_id": "2d5d44bc-240e-4a31-8c44-36e88d4da4bf",
			"migrations_dir": "migrations"
		}
	],
	// One Durable Object per MCP session (the assistant's connection). See worker/mcp.ts.
	"durable_objects": {
		"bindings": [
			{
				"name": "MCP_OBJECT",
				"class_name": "TaskivitiesMCP"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"TaskivitiesMCP"
			]
		}
	],
	// OAuth clients, grants and tokens for MCP clients (@cloudflare/workers-oauth-provider).
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "d6cea42600e84d269acd8a46cd8ec265"
		}
	],
	"vars": {
		// "Today" (and therefore rollover) is computed in this time zone for the whole team.
		"TEAM_TZ": "America/New_York"
	},
	// Secrets (set with `npx wrangler secret put NAME`): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, and optionally ADMIN_EMAILS
	"observability": {
		"enabled": true
	}
}