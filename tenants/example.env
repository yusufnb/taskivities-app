# ───────────────────────────────────────────────────────────────────────────────
# One Taskivities instance (one Worker, one database, one team).
#
# Copy this file to tenants/<instance>.env (for example tenants/acme.env) and fill it in,
# or let `npm run tenant -- create acme` create the database and KV namespace and write
# the file for you. Files in tenants/ are not committed, except this example.
#
# Then: npm run deploy -- acme
#
# Every command below that starts with `npx wrangler` needs you signed in to Cloudflare
# first: `npx wrangler login` (it opens your browser).
# ───────────────────────────────────────────────────────────────────────────────

# ── Worker name (required) ─────────────────────────────────────────────────────
# You choose this. Lowercase letters, numbers and dashes, up to 63 characters.
# The app's address becomes https://<WORKER_NAME>.<your-subdomain>.workers.dev
#   Your workers.dev subdomain: Cloudflare dashboard → Workers & Pages → the
#   "Subdomain" shown in the panel on the right (Account details).
# Using an existing name deploys over that Worker, so pick a new one for a new team.
WORKER_NAME=taskivities-acme

# ── D1 database (required) ─────────────────────────────────────────────────────
# Each instance has its own database; that's what keeps teams' data apart.
#   New:      npx wrangler d1 create taskivities-acme
#             It prints a block with "database_name" and "database_id": copy both.
#   Existing: npx wrangler d1 list   (the "uuid" column is the ID)
#   Dashboard: Storage & Databases → D1 SQL Database → your database → the ID at the top.
D1_DATABASE_NAME=taskivities-acme
D1_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── KV namespace for AI assistant sign-ins (required) ──────────────────────────
# Stores the OAuth grants of Claude and other assistants connected over MCP.
#   New:      npx wrangler kv namespace create taskivities-acme-oauth
#             It prints an "id" (32 letters and numbers): copy it.
#   Existing: npx wrangler kv namespace list   (the "id" field)
#   Dashboard: Storage & Databases → Workers KV → your namespace → the ID column.
OAUTH_KV_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Fallback time zone (optional, default America/New_York) ────────────────────
# Everyone gets their own browser's time zone. This is only used for someone who
# hasn't opened the app yet (for example, when their AI assistant asks first).
# Use a name from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# (the "TZ identifier" column), like Europe/London or Asia/Kolkata.
TEAM_TZ=America/New_York

# ── Custom domains (optional) ──────────────────────────────────────────────────
# Comma-separated host names, no https:// and no path, e.g. tasks.acme.com
# The domain must be a zone in the same Cloudflare account (Dashboard → Websites).
# Cloudflare creates the DNS record and certificate on deploy.
# Remember to add https://<domain>/auth/callback to the Google OAuth client too.
CUSTOM_DOMAINS=

# ── workers.dev address (optional, default true) ───────────────────────────────
# Set to false to only serve the app on CUSTOM_DOMAINS.
WORKERS_DEV=true

# ── Cloudflare account (optional) ──────────────────────────────────────────────
# Only needed if your Cloudflare login has access to more than one account,
# or this instance lives in a different account from the others.
#   npx wrangler whoami   (lists your accounts and their IDs)
#   Dashboard: the 32-character ID in the URL, dash.cloudflare.com/<account id>/…
#   or Account home → ⋯ next to the account name → Copy account ID.
CLOUDFLARE_ACCOUNT_ID=

# ── Secrets: NOT in this file ──────────────────────────────────────────────────
# Secrets are stored encrypted in Cloudflare, per Worker. Set them with:
#   npm run tenant -- secret acme GOOGLE_CLIENT_ID
#   npm run tenant -- secret acme GOOGLE_CLIENT_SECRET
#   npm run tenant -- secret acme ADMIN_EMAILS        (optional)
# You paste each value when asked.
#
# Where the Google values come from: https://console.cloud.google.com
#   APIs & Services → Credentials → Create credentials → OAuth client ID
#   → Application type "Web application"
#   → Authorized redirect URIs: https://<WORKER_NAME>.<your-subdomain>.workers.dev/auth/callback
#     (plus https://<custom domain>/auth/callback for each custom domain)
#   → Create. The dialog shows the Client ID and Client secret.
# One Google client can serve several instances: add each instance's redirect URI to it.
# ADMIN_EMAILS: comma-separated addresses that are always let in as admins.
